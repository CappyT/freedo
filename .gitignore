# Go build output
/freedo
/freedo-dev
/cmd/freedo/freedo
/cmd/freedo-dev/freedo-dev
*.test

# Python
__pycache__/
*.pyc

# Credentials and installation data. Never commit them.
.ha_token
tado_capture/.ha_token
.env
freedo_api_token

# Installation config: it holds the network key and the device list.
# freedo.example.yaml is the committed template.
freedo.yaml
freedo.yml
freedo.*.yaml
freedo.*.yml
!freedo.example.yaml
*.key

# Large RF recordings and device images. Reduced fixtures live in tado/testdata.
*.iq
*.bin

# Third-party packages
*.apk

# Arduino build output of the bridge firmware
firmware/*/build/

# Bench output: captures, snapshots and per-test logs
/bench/

# Logs and local state
/.tmp-check/
/.tmp-race/
/*.log
/freedo-state.db
/freedo-state.db-wal
/freedo-state.db-shm
tado_capture/*.log
tado_capture/*.json

# Local working notes and recordings
tado_capture/memory/

# Editor and tool configuration, local to each developer
.idea/
.vscode/
.mcp.json
.claude/

# Local tooling output and device dumps. They can hold installation values.
tado_capture/ota-watch/
tado_capture/ota-fetch/
tado_capture/internet_bridge/
tado_capture/thermostat_ru/
tado_capture/valve_nrf52/
tado_capture/extflash/

# Collector output: logged samples and access tokens.
tado_capture/flow-watch/data/
tado_capture/flow-watch/.token.json*

# Developer run output
docker-compose.yml
.pytest_cache/
.venv/
coverage.out
*.prof
freedo-state.db.bak-*
freedo-state.db-journal
tado_capture/capture-*-marks.txt
