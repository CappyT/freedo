  (fp_line (start -5 2.1) (end 5 2.1) (stroke (width 0.1) (type solid)) (layer "Dwgs.User"))
  (pad "1" smd rect (at 0 0) (size 1.2 4.2) (layers "F.Cu" "F.Mask")  )
  (pad "2" smd rect (at -2.825 0) (size 1.2 4.2) (layers "F.Cu" "F.Mask")  )
  (pad "2" smd rect (at 2.825 0) (size 1.2 4.2) (layers "F.Cu" "F.Mask")  )
  (pad "2" smd rect (at -2.825 0) (size 1.2 4.2) (layers "B.Cu" "B.Mask")  )
  (pad "2" smd rect (at 2.825 0) (size 1.2 4.2) (layers "B.Cu" "B.Mask")  )
  (fp_rect (start -3.75 -2.35) (end 3.75 11.75) (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
  (fp_line (start -3.65 -2.25) (end -3.65 2.1) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start 3.65 -2.25) (end 3.65 2.1) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start -3.65 -2.25) (end -3.4 -2.25) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_line (start 3.65 -2.25) (end 3.4 -2.25) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
  (fp_rect (start -3.25 2.1) (end 3.25 3.5) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -3.1 3.5) (end 3.1 11.43) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
  (fp_line (start 0 -2.1) (end 0 2.1) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
  (fp_text reference "REF**" (at 0.0000 -3.3500 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "SMA_XUNPU_SMA-KE-347-H13.5-1.6_EdgeMount" (at 0.0000 3.3500 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15))))
  (model "${KIPRJMOD}/lib/3dmodels/SMA-SMD_SMA-KE-347-H13.5-1.6.wrl"
