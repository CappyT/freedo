(footprint "SMA_XUNPU_SMA-KE-347-H13.5-1.6_EdgeMount"
  (version 20240108)
  (generator "konnect")
  (layer "F.Cu")
  (descr "XUNPU SMA-KE-347-H13.5-1.6 end-launch SMA jack for a 1.6 mm board. Recommended PCB layout: three 1.20 x 4.20 mm pads, 5.65 mm span, pads end at the board edge (Dwgs.User line). Ground pads repeated on B.Cu. No paste: hand-soldered.")
