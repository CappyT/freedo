  (text "RF: CC1101 868 MHz transceiver, TI CC1101EM 868/915 MHz rev 3.0.0 topology (SWRR045, spec 5.1)"
    (at 58.42 78.74 0)
    (effects (font (size 2.54 2.54) (thickness 0.4)) (justify left bottom))
    (uuid "33723fe9-adab-4db3-b87b-bc8be79ddccb")
  )
  (text "Each 100nF next to its supply pin, with its own vias. Route supply -> capacitor -> pin (spec 6.1)."
    (at 106.68 93.98 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "31b1b936-8efa-4c3d-b0a4-3d977ac1db39")
  )
  (text "Filterbalun L121-L132, C121-C124: copy the TI CC1101EM placement, 0402, symmetric (spec 6.1)."
    (at 241.3 121.92 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "4bf8bdac-079b-4417-a843-b2dbf600a03b")
  )
  (text "Wire-wound LQW15AN inductors. Keep C124 and C125: no DC path from RF_P/RF_N to GND."
    (at 241.3 124.46 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "89998ef7-aa7d-4806-84dd-efe2287b1213")
  )
  (text "C126, L125 DNP: fit only if the spectrum measurement\nshows the 699 MHz spur (SWRS061I Table 10, DN017 4)."
    (at 320.04 154.94 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "ecafb053-95ca-4969-84d4-b806cc35d1c2")
  )
  (text "C191, C192 DNP: pi pads to retune positions.\nC125 -> R191 -> J1: 50 ohm grounded coplanar line.\nJ1: edge SMA at the board edge, hand-soldered."
    (at 320.04 162.56 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "e40fe2f9-dbfb-4f2f-bfb2-54e096985d56")
  )
  (text "X1: no digital lines near XOSC_Q1 or under the X1 pin 1 pad.\nC81, C101 between U1 and X1 (spec 6.1)."
    (at 193.04 184.15 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "ce9e6fe8-780c-4d50-a11e-22f3edc3433c")
  )
  (text "DCOUPL (pin 5): C51 only.\nR171 next to pin 17."
    (at 160.02 175.26 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "58eb27a8-d180-4eeb-940f-76e94958bea1")
  )
  (text "TP101-TP107: 1.5 mm round test pads, top side (spec 5.5).\nR210 keeps U1 deselected while the ESP32 boots."
    (at 58.42 226.06 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "417804c7-cb3a-419e-ad2b-8a896183fd35")
  )
