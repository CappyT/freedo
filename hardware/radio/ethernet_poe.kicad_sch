  (text "LINE SIDE (PoE, isolated)"
    (at 134.62 24.13 0)
    (effects (font (size 2 2) (thickness 0.4) (bold yes)) (justify right bottom))
    (uuid "e7f17658-74ba-4ccb-a796-5e898e1cd023")
  )
  (text "SYSTEM SIDE"
    (at 144.78 24.13 0)
    (effects (font (size 2 2) (thickness 0.4) (bold yes)) (justify left bottom))
    (uuid "54182115-7373-498f-b7bc-d120ddaf5f50")
  )
  (text "ISOLATION BARRIER (dashed line)\nisolation >= 2 mm on every layer, 3 mm target (spec 6.2)\nOnly T301, U401, C322 and C323 cross it.\nLine side: J301, T301 pins 9-16, Bob Smith, BR401, BR402,\nD401, U401 pins 5-8. System side: everything else."
    (at 144.78 116.84 0)
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid "2568d74b-6c7a-4aa6-a382-db47f6aa0796")
  )
  (text "no plane under T301"
    (at 144.78 81.28 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "33af60a2-0545-4d59-a79b-e8ac0c9d8d37")
  )
  (text "hand-soldered, optional: PoE boards only"
    (at 139.7 233.68 0)
    (effects (font (size 1.27 1.27)) (justify bottom))
    (uuid "60f768b7-6134-46d8-b1f4-91c2c73d3c6b")
  )
  (text "R401: 0R = 5.66 V so PoE wins the diode-OR (spec 4.3)"
    (at 152.4 238.76 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid "0549fb2d-863f-4a44-bc95-b10752bceada")
  )
  (text "Bob Smith, PoE-aware (spec 5.3): 75R + 10 nF 100 V per power line.\nC322, C323: 1 nF 2 kV 1808, they cross the barrier.\nNo DC path from SHIELD to GND."
    (at 22.86 165.1 0)
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid "1a00ecd7-2a32-4d60-b93c-de7c74fa8b15")
  )
  (text "C305-C310: one 100 nF at each AVDD pin (4, 8, 11, 15, 17, 21).\nC312, C313 at VDD (28)."
    (at 236.22 113.03 0)
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid "058125a1-db5c-49ec-bf3e-7d299f12362b")
  )
  (text "MDI: 100 ohm differential pairs, equal length (spec 6.3).\nR309-R312: 0R damping (WIZnet note a: 33R gave the best EMI)."
    (at 167.64 110.49 0)
    (effects (font (size 1.27 1.27)) (justify left top))
    (uuid "fa410d8c-bea0-4495-95fa-14e3f029d8e9")
  )
